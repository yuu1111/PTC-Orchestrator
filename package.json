{
	"name": "ptc-orchestrator",
	"version": "0.2.0",
	"private": true,
	"main": "dist/main.js",
	"exports": {
		".": "./dist/main.js"
	},
	"type": "module",
	"description": "ローカルモデルによるAPIモデルへの委任向けプリセット PTCベースでMCPはIDAのみ公開",
	"license": "MIT",
	"engines": {
		"node": ">=22.19"
	},
	"files": [
		"dist",
		"cordis.patch.yml",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test --test-reporter=spec tests/*.test.ts",
		"check:upstream": "node scripts/check-upstream.ts",
		"check:quality": "quality-check",
		"format": "biome check --write .",
		"build": "tsc -p tsconfig.build.json",
		"check": "npm run build && npm run check:quality && npm test"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@deepseek-ai/cordis": "^4.0.4",
		"@deepseek-ai/cordis-plugin-loader": "^1.0.5",
		"@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-agent-preset-registry": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-mcp-resources": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-ptc-runtime": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
		"@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.6.5",
		"@yuu1111/biome-config": "^2.2.2",
		"@yuu1111/knip-config": "^2.1.0",
		"@yuu1111/quality-check": "^5.3.1",
		"@yuu1111/tsconfig": "^1.0.8",
		"js-yaml": "^4.3.2",
		"knip": "^6.41.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"zod": "^4.6.7"
	}
}
